# Telegram credentials (https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE=+8613800138000

# Explicitly authorized groups, comma-separated
TARGET_GROUPS=https://t.me/authorized_group1,https://t.me/authorized_group2

# Legacy round interval values retained for configuration compatibility
MIN_INTERVAL=20
MAX_INTERVAL=30
GROUP_GAP_MIN=1
GROUP_GAP_MAX=1

# Optional proxy
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890
# PROXY_TYPE=http

# Optional per-group TXT fallback mapping: group|path,group|path
# MESSAGE_FILES=https://t.me/authorized_group1|messages.txt

# Optional AI generation
AI_ENABLED=false
# AI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_PROMPT=作为普通群友，根据最近对话简短、自然地参与；不要虚构身份或经历。
AI_CONTEXT_COUNT=5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500
AI_TIMEOUT=30

# Optional work windows
SCHEDULE_ENABLED=false
SCHEDULE_MORNING_START=08:00
SCHEDULE_MORNING_END=11:00
SCHEDULE_AFTERNOON_START=14:00
SCHEDULE_AFTERNOON_END=18:00

# Authorized-group participation policy
DAILY_LIMIT=30
IDLE_THRESHOLD_MINUTES=10
QUESTION_REPLY_PCT=70
DISCUSSION_REPLY_PCT=15
REPLY_DELAY_MIN=20
REPLY_DELAY_MAX=90
STATE_DB_PATH=state/be_water.db

# 宽松群：仅按“最近消息是否含自己发送”触发，并执行铺量发送。
# 宽松群必须同时出现在 TARGET_GROUPS 中（列表交集生效）。
LOOSE_GROUPS=https://t.me/laolangtaolunqun
# 宽松群冷却时间（分钟）：两次铺量发送之间的最小间隔
LOOSE_COOLDOWN_MIN=10
# 宽松群语料库文件（逗号分隔短句风格，每行一条）
LOOSE_MESSAGE_FILE=egg_answers.txt
# 一次铺量发送的最少 / 最多条数（从语料按逗号拆出的短句中随机取）
LOOSE_MIN_PARTS=2
LOOSE_MAX_PARTS=5
# 每条之间的随机发送间隔（秒）
LOOSE_PART_GAP_MIN=5
LOOSE_PART_GAP_MAX=10
